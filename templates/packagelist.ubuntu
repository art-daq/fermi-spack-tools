########################################################################
# Package list for Ubuntu/Debian systems
#
# Field 1: base Ubuntu/Debian package name (or POSIX search regex with
#          substitution groups).
#
# Field 2: Spack package name as a string.
#
# Field 3: Ubuntu/Debian development package name as:
#          a) a string.
#          b) a POSIX replacement regex with match placeholders.
#          In either case, an occurrence of "$0" will be replaced by the
#          corresponding matched base package name.
#
# Note: Ubuntu package names differ from RPM names (e.g. libX11 on RPM
#       is libx11-6 on Ubuntu, and the -devel suffix becomes -dev).
########################################################################
asciidoc:asciidoc:$0
autoconf:autoconf:$0
autogen:autogen:$0
automake:automake:$0
xfonts-utils:bdftopcf:$0
(libdb5\.3|libdb5\.3t64):berkeley-db:libdb-dev
